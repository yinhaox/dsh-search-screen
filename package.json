{
  "name": "@yinhaox/dsh-search-screen",
  "version": "0.2.0",
  "description": "A full-window web search page for the DeepSeek Harness Web UI, using the same search provider as the agent's web_search tool, with an in-page reader for result pages.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "search",
    "web-search",
    "deepseek-search",
    "ui"
  ],
  "license": "MIT",
  "author": "yinhaox <yinhaox@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinhaox/dsh-search-screen.git"
  },
  "homepage": "https://github.com/yinhaox/dsh-search-screen#readme",
  "bugs": {
    "url": "https://github.com/yinhaox/dsh-search-screen/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "handler.js",
    "page.js",
    "extract.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
